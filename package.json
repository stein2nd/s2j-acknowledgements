{
  "name": "@s2j/acknowledgements",
  "version": "0.1.18",
  "description": "Generate Acknowledgements for third-party software, libraries, and tools used in your projects.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "s2j-acknowledgements": "dist/bin/cli.js"
  },
  "files": [
    "dist/",
    "presets/",
    "schema/",
    "config/",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint:docs": "s2j-docs-linter ./README.md ./CHANGELOG.md ./docs/*.md ./docs/**/*.md ./docs_mod/*.md ./docs_mod/**/*.md  ./examples/**/*.md",
    "docs:heading-tags": "python3 scripts/apply-heading-tags.py",
    "lint": "eslint . && npm run typecheck",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist",
    "build": "vite build",
    "typecheck": "tsc6 -p tsconfig.json --noEmit",
    "dev": "vite build --watch",
    "format": "prettier --write \"**/*.{ts,mjs,cjs,js,json}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,cjs,js,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:doctor": "bash scripts/test-doctor.sh",
    "prepare": "npm run build",
    "dist": "npm run dist:build && npm run dist:zip",
    "dist:build": "npm run build",
    "dist:zip": "node scripts/dist/make-dist-zip.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@s2j/docs-linter": "^1.0.38",
    "@types/node": "^26.6.11",
    "archiver": "^8.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "@s2j/docs-linter": true
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
